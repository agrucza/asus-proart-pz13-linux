#!/bin/sh
# systemd-sleep hook (/usr/lib/systemd/system-sleep/): after resume, send the keyboard
# cover its backlight feature report. A key held during suspend triggers the keyboard's
# firmware reset, which wipes the cover's state while the kernel reset-resumes it as the
# same device; the cover only sends its Fn-layer reports after that report.
[ "$1" = "post" ] || exit 0
sleep 3
/usr/local/bin/kbdlight "$(cat /run/pz13-kbdlight.level 2>/dev/null || echo 1)" 2>/dev/null
exit 0
