#!/usr/bin/env python3
"""net.hadess.SensorProxy for the ASUS ProArt PZ13's accelerometer.

The tablet's IMU hangs on the Qualcomm Sensor Core in the ADSP (QMI service
400 over QRTR, protobuf payloads). This daemon owns the SensorProxy name on
the system bus like iio-sensor-proxy would for an IIO accelerometer, streams
the "accel" sensor while a client has claimed it, and publishes the
orientation computed the way iio-sensor-proxy does. No light or proximity
sensor exists on this machine.

The sensor core needs its configuration served over FastRPC first
(see notes/sensors.md); until then the accelerometer is simply absent.

  pz13-sensor-proxy            # daemon (root: the bus policy lets root own the name)
  pz13-sensor-proxy --debug    # also print every sample and orientation change
"""
import math
import socket
import struct
import sys
import threading
import time

import gi
gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

AF_QIPCRTR = 42
SNS_SERVICE = 400
QMI_REQ, QMI_IND, QMI_JUMBO_IND = 0x20, 0x21, 0x22
SUID_LOOKUP = (0xABABABABABABABAB, 0xABABABABABABABAB)
MSG_SUID_REQ, MSG_SUID_EVENT = 512, 768
MSG_STREAM_CONFIG, MSG_SENSOR_EVENT, MSG_ERROR_EVENT = 513, 1025, 130
RATE_HZ = 12.5

# The sensor core's accelerometer axes against the convention the orientation
# code expects (as iio-sensor-proxy: upright gives y = -1 g, right edge up
# gives x = -1 g): each output axis = sign * input axis. Measured on the
# device: upright y = +9.8, right edge up x = +9.8, so both are inverted.
MOUNT = ((0, -1.0), (1, -1.0), (2, 1.0))

BUS_NAME = "net.hadess.SensorProxy"
OBJECT_PATH = "/net/hadess/SensorProxy"
INTROSPECTION = """
<node>
  <interface name='net.hadess.SensorProxy'>
    <method name='ClaimLight'/>
    <method name='ReleaseLight'/>
    <method name='ClaimAccelerometer'/>
    <method name='ReleaseAccelerometer'/>
    <method name='ClaimProximity'/>
    <method name='ReleaseProximity'/>
    <property name='HasAccelerometer' type='b' access='read'/>
    <property name='AccelerometerOrientation' type='s' access='read'/>
    <property name='HasAmbientLight' type='b' access='read'/>
    <property name='LightLevelUnit' type='s' access='read'/>
    <property name='LightLevel' type='d' access='read'/>
    <property name='HasProximity' type='b' access='read'/>
    <property name='ProximityNear' type='b' access='read'/>
  </interface>
</node>
"""

DEBUG = "--debug" in sys.argv


def log(msg):
    print(msg, flush=True)


# ---- protobuf / QMI framing ----

def varint(n):
    out = b""
    while True:
        b, n = n & 0x7F, n >> 7
        out += bytes([b | (0x80 if n else 0)])
        if not n:
            return out


def pb_bytes(f, d): return varint(f << 3 | 2) + varint(len(d)) + d
def pb_varint(f, v): return varint(f << 3) + varint(v)
def pb_fixed32(f, v): return varint(f << 3 | 5) + struct.pack("<I", v)
def pb_fixed64(f, v): return varint(f << 3 | 1) + struct.pack("<Q", v)
def pb_float(f, v): return varint(f << 3 | 5) + struct.pack("<f", v)


def read_varint(buf, i):
    val = shift = 0
    while i < len(buf):
        b = buf[i]
        i += 1
        val |= (b & 0x7F) << shift
        if not b & 0x80:
            break
        shift += 7
    return val, i


def pb_parse(buf):
    out, i = {}, 0
    while i < len(buf):
        t, i = read_varint(buf, i)
        f, w = t >> 3, t & 7
        if w == 0:
            v, i = read_varint(buf, i)
        elif w == 1:
            v, i = buf[i:i + 8], i + 8
        elif w == 2:
            n, i = read_varint(buf, i)
            v, i = buf[i:i + n], i + n
        elif w == 5:
            v, i = buf[i:i + 4], i + 4
        else:
            break
        out.setdefault(f, []).append(v)
    return out


def qmi_encode(msg_id, txn, payload):
    tlv = struct.pack("<H", len(payload)) + payload
    body = b"\x01" + struct.pack("<H", len(tlv)) + tlv
    return struct.pack("<BHHH", 0, txn, msg_id, len(body)) + body


def qmi_decode(buf):
    if len(buf) < 7:
        return None, {}
    _, _, msg_id, _ = struct.unpack_from("<BHHH", buf, 0)
    tlvs, i = {}, 7
    while i + 3 <= len(buf):
        t, n = buf[i], struct.unpack_from("<H", buf, i + 1)[0]
        tlvs[t] = buf[i + 3:i + 3 + n]
        i += 3 + n
    return msg_id, tlvs


def events(tlvs):
    if 2 not in tlvs:
        return
    for e in pb_parse(tlvs[2][2:]).get(2, []):
        inner = pb_parse(e)
        if 1 in inner:
            yield struct.unpack("<I", inner[1][0])[0], (inner[3][0] if 3 in inner else b"")


def client_request(suid, msg_id, payload=b""):
    suid_msg = pb_fixed64(1, suid[0]) + pb_fixed64(2, suid[1])
    susp = pb_varint(1, 1) + pb_varint(2, 0)
    req = pb_bytes(2, payload) if payload else b""
    return pb_bytes(1, suid_msg) + pb_fixed32(2, msg_id) + pb_bytes(3, susp) + pb_bytes(4, req)


def find_service():
    s = socket.socket(AF_QIPCRTR, socket.SOCK_DGRAM, 0)
    s.settimeout(2.0)
    try:
        s.sendto(struct.pack("<5I", 10, 0, 0, 0, 0), (1, 0xFFFFFFFE))
        found = None
        while True:
            try:
                data, _ = s.recvfrom(4096)
            except socket.timeout:
                return found
            if len(data) >= 20:
                cmd, svc, _, node, port = struct.unpack_from("<5I", data, 0)
                if cmd == 4 and svc == SNS_SERVICE:
                    found = (node, port)
    finally:
        s.close()


def lookup_suid(addr, data_type):
    s = socket.socket(AF_QIPCRTR, socket.SOCK_DGRAM, 0)
    s.settimeout(3.0)
    try:
        req = client_request(SUID_LOOKUP, MSG_SUID_REQ, pb_bytes(1, data_type.encode()) + pb_varint(2, 0))
        s.sendto(qmi_encode(QMI_REQ, 1, req), addr)
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline:
            try:
                data, _ = s.recvfrom(65536)
            except socket.timeout:
                return None
            msg_id, tlvs = qmi_decode(data)
            if msg_id not in (QMI_IND, QMI_JUMBO_IND):
                continue
            for eid, pay in events(tlvs):
                if eid == MSG_SUID_EVENT:
                    for sb in pb_parse(pay).get(2, []):
                        su = pb_parse(sb)
                        return (struct.unpack("<Q", su[1][0])[0], struct.unpack("<Q", su[2][0])[0])
                    return None
        return None
    finally:
        s.close()


# ---- orientation (iio-sensor-proxy's orientation_calc) ----

ORIENTATIONS = ("undefined", "normal", "bottom-up", "left-up", "right-up")
THRESHOLD = 35
SAME_AXIS_LIMIT = 5


def orientation_calc(prev, x, y, z):
    portrait = round(math.degrees(math.atan2(x, math.hypot(y, z))))
    landscape = round(math.degrees(math.atan2(y, math.hypot(x, z))))
    if abs(portrait) > THRESHOLD and abs(landscape) > THRESHOLD:
        return prev
    ret = prev
    if abs(portrait) > THRESHOLD:
        ret = "left-up" if portrait > 0 else "right-up"
        if prev in ("left-up", "right-up") and abs(portrait) < SAME_AXIS_LIMIT:
            ret = prev
    elif abs(landscape) > THRESHOLD:
        ret = "bottom-up" if landscape > 0 else "normal"
        if prev in ("bottom-up", "normal") and abs(landscape) < SAME_AXIS_LIMIT:
            ret = prev
    return ret


class SensorProxy:
    def __init__(self):
        self.conn = None
        self.reg_id = 0
        self.claimers = {}
        self.has_accel = False
        self.orientation = "undefined"
        self.addr = None
        self.suid = None
        self.stream_thread = None
        self.stop_event = threading.Event()
        self.node_info = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)

    # --- bus ---
    def start(self):
        Gio.bus_own_name(Gio.BusType.SYSTEM, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
                         self.on_bus_acquired, None, self.on_name_lost)

    def on_bus_acquired(self, conn, name):
        self.conn = conn
        self.reg_id = conn.register_object(OBJECT_PATH, self.node_info.interfaces[0],
                                           self.on_method_call, self.on_get_property, None)
        threading.Thread(target=self.discover, daemon=True).start()

    def on_name_lost(self, conn, name):
        log(f"lost {name}, exiting")
        sys.exit(1)

    def on_get_property(self, conn, sender, path, iface, prop):
        props = {
            "HasAccelerometer": GLib.Variant("b", self.has_accel),
            "AccelerometerOrientation": GLib.Variant("s", self.orientation),
            "HasAmbientLight": GLib.Variant("b", False),
            "LightLevelUnit": GLib.Variant("s", "lux"),
            "LightLevel": GLib.Variant("d", 0.0),
            "HasProximity": GLib.Variant("b", False),
            "ProximityNear": GLib.Variant("b", False),
        }
        return props.get(prop)

    def emit_changed(self, props):
        changed = GLib.Variant("a{sv}", props)
        self.conn.emit_signal(None, OBJECT_PATH, "org.freedesktop.DBus.Properties",
                              "PropertiesChanged",
                              GLib.Variant.new_tuple(GLib.Variant("s", BUS_NAME), changed,
                                                     GLib.Variant("as", [])))

    def on_method_call(self, conn, sender, path, iface, method, params, invocation):
        if method == "ClaimAccelerometer":
            self.claim(sender)
        elif method == "ReleaseAccelerometer":
            self.release(sender)
        invocation.return_value(None)

    # --- claims (main loop thread) ---
    def claim(self, sender):
        if sender in self.claimers:
            refs, watch = self.claimers[sender]
            self.claimers[sender] = (refs + 1, watch)
            return
        watch = Gio.bus_watch_name_on_connection(self.conn, sender, Gio.BusNameWatcherFlags.NONE,
                                                 None, lambda c, n: self.drop(n))
        self.claimers[sender] = (1, watch)
        log(f"accelerometer claimed by {sender}")
        if len(self.claimers) == 1:
            self.start_stream()

    def release(self, sender):
        if sender not in self.claimers:
            return
        refs, watch = self.claimers[sender]
        if refs > 1:
            self.claimers[sender] = (refs - 1, watch)
        else:
            self.drop(sender)

    def drop(self, sender):
        if sender not in self.claimers:
            return
        _, watch = self.claimers.pop(sender)
        Gio.bus_unwatch_name(watch)
        log(f"accelerometer released by {sender}")
        if not self.claimers:
            self.stop_stream()

    # --- sensor ---
    def discover(self):
        """Wait for the sensor core and its accelerometer (the configuration
        is served by a separate service and may come later)."""
        while True:
            try:
                addr = find_service()
                suid = lookup_suid(addr, "accel") if addr else None
            except OSError as e:
                log(f"sensor core lookup failed: {e!r}")
                addr = suid = None
            if suid:
                self.addr, self.suid = addr, suid
                log(f"accelerometer at node {addr[0]} port {addr[1]}: {suid[0]:#x}/{suid[1]:#x}")
                GLib.idle_add(self.set_has_accel)
                return
            time.sleep(5)

    def set_has_accel(self):
        self.has_accel = True
        self.emit_changed({"HasAccelerometer": GLib.Variant("b", True)})
        if self.claimers:
            self.start_stream()
        if DEBUG and not self.claimers:
            self.start_stream()

    def start_stream(self):
        if not self.suid or self.stream_thread:
            return
        self.stop_event.clear()
        self.stream_thread = threading.Thread(target=self.stream, daemon=True)
        self.stream_thread.start()

    def stop_stream(self):
        self.stop_event.set()
        self.stream_thread = None

    def stream(self):
        s = socket.socket(AF_QIPCRTR, socket.SOCK_DGRAM, 0)
        s.settimeout(1.0)
        try:
            cfg = pb_float(1, RATE_HZ)
            s.sendto(qmi_encode(QMI_REQ, 2, client_request(self.suid, MSG_STREAM_CONFIG, cfg)), self.addr)
            prev = self.orientation
            n = 0
            while not self.stop_event.is_set():
                try:
                    data, _ = s.recvfrom(65536)
                except socket.timeout:
                    continue
                msg_id, tlvs = qmi_decode(data)
                if msg_id not in (QMI_IND, QMI_JUMBO_IND):
                    continue
                for eid, pay in events(tlvs):
                    if eid != MSG_SENSOR_EVENT:
                        continue
                    floats = []
                    for v in pb_parse(pay).get(1, []):
                        floats += [struct.unpack_from("<f", v, o)[0] for o in range(0, len(v) - 3, 4)]
                    if len(floats) < 3:
                        continue
                    x, y, z = (sign * floats[axis] for axis, sign in MOUNT)
                    cur = orientation_calc(prev, x, y, z)
                    n += 1
                    if DEBUG and n % int(RATE_HZ) == 0:
                        log(f"raw {floats[0]:7.2f} {floats[1]:7.2f} {floats[2]:7.2f}  mapped {x:7.2f} {y:7.2f} {z:7.2f}  {cur}")
                    if cur != prev:
                        prev = cur
                        GLib.idle_add(self.set_orientation, cur)
        finally:
            # An empty stream config stops the stream on the core side
            try:
                s.sendto(qmi_encode(QMI_REQ, 3, client_request(self.suid, MSG_STREAM_CONFIG, pb_float(1, 0.0))), self.addr)
            except OSError:
                pass
            s.close()

    def set_orientation(self, cur):
        self.orientation = cur
        log(f"orientation {cur}")
        self.emit_changed({"AccelerometerOrientation": GLib.Variant("s", cur)})


def main():
    proxy = SensorProxy()
    proxy.start()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
