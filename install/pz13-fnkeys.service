[Unit]
Description=ASUS ProArt PZ13 keyboard cover Fn keys (hidraw -> uinput) and backlight LED
# UPower looks for the keyboard backlight LED only once, at its start
Before=upower.service

[Service]
ExecStart=/usr/local/bin/pz13-fnkeys
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
