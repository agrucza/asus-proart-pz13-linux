From 546c3e8293494456539cd3c38204115a6b75d9d7 Mon Sep 17 00:00:00 2001
From: agrucza <a.grucza@gmx.net>
Date: Sat, 10 Oct 2026 18:10:49 +0200
Subject: [PATCH 10/12] drm/msm/dp: allow audio startup while the display is
 off

msm_dp_audio_startup() returned -ENOTSUPP whenever the DP display was
not powered, so the DisplayPort PCMs could not be opened without a
monitor attached. PipeWire probes every PCM of a UCM verb when it builds
the card's profile and marks the whole verb unsupported if one open
fails; on the ASUS ProArt PZ13 that removed the speakers and microphones
from PipeWire as soon as the UCM profile gained the DisplayPort outputs.

msm_dp_audio_prepare() already skips the register programming while the
display is off, with a comment saying that user space may probe the PCMs
in that state, and the jack reports sink availability. Let the startup
succeed, as mainline does.

Signed-off-by: agrucza <a.grucza@gmx.net>
---
 drivers/gpu/drm/msm/dp/dp_drm.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_drm.c b/drivers/gpu/drm/msm/dp/dp_drm.c
index c03b54618..8b80200e7 100644
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -52,12 +52,14 @@ static void msm_dp_bridge_debugfs_init(struct drm_bridge *bridge, struct dentry
 static int msm_dp_audio_startup(struct drm_bridge *bridge,
                                 struct drm_connector *connector)
 {
-        struct msm_dp *msm_dp_display = to_dp_bridge(bridge)->msm_dp_display;
-
-        if (!msm_dp_display->power_on)
-                return -ENOTSUPP;
-
-        return 0;
+	/*
+	 * User space probes the DP PCMs while the connector is unplugged
+	 * (PipeWire opens every PCM of a UCM verb and drops the whole verb
+	 * if one open fails). Let the open succeed; msm_dp_audio_prepare()
+	 * skips the register programming while the display is off, and the
+	 * jack reports whether a sink is available.
+	 */
+	return 0;
 }
 
 static const struct drm_bridge_funcs msm_dp_bridge_ops = {
