 	const struct mipi_csi2phy_lane_regs *r = regs->init_seq;
 	int i, array_size = regs->lane_array_size;
 	u32 val;
 
+	if (combo && regs->init_seq_combo) {
+		r = regs->init_seq_combo;
+		array_size = regs->lane_array_size_combo;
+	}
+
 	for (i = 0; i < array_size; i++, r++) {
