+	 * instead of the dedicated clock lane (Qualcomm cam_csiphy: lane_assign
+	 * 2 + combo => DPHY_LANE_2 | DPHY_LANE_3).
+	 */
+	if (cfg->combo_mode && cfg->num_data_lanes == 1 &&
+	    lane_cfg->data[0].pos == 2)
+		val = BIT(2 * 2) | BIT(3 * 2);
+	else
+		val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 	for (i = 0; i < cfg->num_data_lanes; i++)
 		val |= BIT(lane_cfg->data[i].pos * 2);
 
+	dev_dbg(csi2phy->dev, "lanes enable 0x%02x combo=%u lanes=%u pos0=%u settle=%u\n",
+		val, cfg->combo_mode, cfg->num_data_lanes, lane_cfg->data[0].pos, settle_cnt);
