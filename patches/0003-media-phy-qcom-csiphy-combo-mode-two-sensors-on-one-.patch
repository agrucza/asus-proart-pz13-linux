From bdef81b309a2a8a4a93e1decf5ec726f7b3f952a Mon Sep 17 00:00:00 2001
From: agrucza <a.grucza@gmx.net>
Date: Wed, 7 Oct 2026 11:17:31 +0200
Subject: [PATCH 3/5] media/phy: qcom: csiphy combo mode (two sensors on one
 CSIPHY)

A CSIPHY can be shared by two D-PHY sensors using disjoint lanes: sensor A
on DL0/DL1 with the dedicated clock lane, sensor B on DL2 with DL3 as its
clock lane (Qualcomm "combo mode"; cam_csiphy: lane_assign 2 + combo =>
DPHY_LANE_2 | DPHY_LANE_3). Used by the ASUS ProArt PZ13 front RGB (OV5675)
and IR (HM1092) cameras on csiphy4.

camss: create mutable sensor links when a CSIPHY has more than one sensor,
take the lane configuration from the sensor whose link is enabled, flag the
CSIPHY as combo, and hand the physical lane assignment and the combo flag to
the PHY through phy_set_mode_ext() submode (the generic MIPI D-PHY configure
opts only carry the lane count).

phy-qcom-mipi-csi2: honour the lane assignment from set_mode instead of
assuming lanes 0..n-1; in combo mode enable DL2+DL3 for the second port and
program the lanes from a combo table (x1e80100: DL3 block configured like the
clock lane, after Qualcomm's csiphy_2ph_*_combo_mode_reg tables).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../media/platform/qcom/camss/camss-csiphy.c  |  35 ++++-
 drivers/media/platform/qcom/camss/camss.c     |  45 +++++-
 .../qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c    | 148 +++++++++++++++++-
 .../phy/qualcomm/phy-qcom-mipi-csi2-core.c    |  39 ++++-
 drivers/phy/qualcomm/phy-qcom-mipi-csi2.h     |  17 ++
 5 files changed, 267 insertions(+), 17 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
index 8d2e7e865..80d565d06 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -330,7 +330,8 @@ static int csiphy_stream_on(struct csiphy_device *csiphy)
 	union phy_configure_opts dphy_opts = { 0 };
 	struct device *dev = csiphy->camss->dev;
 	s64 link_freq;
-	int ret;
+	u32 submode;
+	int i, ret;
 
 	dphy_cfg = &dphy_opts.mipi_dphy;
 
@@ -344,7 +345,20 @@ static int csiphy_stream_on(struct csiphy_device *csiphy)
 
 	phy_mipi_dphy_get_default_config_for_hsclk(link_freq, num_lanes, dphy_cfg);
 
-	phy_set_mode(csiphy->phy, PHY_MODE_MIPI_DPHY);
+	/*
+	 * Tell the PHY which physical lanes carry the logical data lanes and
+	 * whether it is shared by two sensors (combo mode); the generic
+	 * phy_configure_opts_mipi_dphy only carries the lane count.
+	 * Submode layout: bits 15:0 lane assignment (nibble n = position of
+	 * logical lane n), bit 16 combo, bit 31 valid.
+	 */
+	submode = BIT(31);
+	if (csiphy->cfg.combo_mode)
+		submode |= BIT(16);
+	for (i = 0; i < num_lanes; i++)
+		submode |= (csiphy->cfg.csi2->lane_cfg.data[i].pos & 0xf) << (4 * i);
+
+	phy_set_mode_ext(csiphy->phy, PHY_MODE_MIPI_DPHY, submode);
 
 	ret = phy_configure(csiphy->phy, &dphy_opts);
 	if (ret) {
@@ -854,6 +868,23 @@ static int csiphy_link_setup(struct media_entity *entity,
 		csiphy->cfg.csid_id = csid->id;
 	}
 
+	/*
+	 * Sink link enabled: take the lane configuration of the sensor behind
+	 * it (several sensors may share this CSIPHY in combo mode).
+	 */
+	if ((local->flags & MEDIA_PAD_FL_SINK) &&
+	    (flags & MEDIA_LNK_FL_ENABLED)) {
+		struct v4l2_subdev *sd = media_entity_to_v4l2_subdev(entity);
+		struct csiphy_device *csiphy = v4l2_get_subdevdata(sd);
+		struct v4l2_subdev *sensor;
+		struct camss_async_subdev *csd;
+
+		sensor = media_entity_to_v4l2_subdev(remote->entity);
+		csd = sensor->host_priv;
+		if (csd)
+			csiphy->cfg.csi2 = &csd->interface.csi2;
+	}
+
 	return 0;
 }
 
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 4c4827de2..9e26aa264 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -5178,8 +5178,15 @@ static int camss_subdev_notifier_bound(struct v4l2_async_notifier *async,
 	u8 id = csd->interface.csiphy_id;
 	struct csiphy_device *csiphy = &camss->csiphy[id];
 
-	csiphy->cfg.csi2 = &csd->interface.csi2;
-	subdev->host_priv = csiphy;
+	/*
+	 * Several sensors may share one CSIPHY (combo mode, e.g. an RGB sensor
+	 * on lanes 0-1 and an IR sensor on lane 2). The first sensor bound to
+	 * a CSIPHY provides its initial lane configuration; csiphy_link_setup()
+	 * switches it when another sensor's link gets enabled.
+	 */
+	if (!csiphy->cfg.csi2)
+		csiphy->cfg.csi2 = &csd->interface.csi2;
+	subdev->host_priv = csd;
 
 	return 0;
 }
@@ -5191,17 +5198,44 @@ static int camss_subdev_notifier_complete(struct v4l2_async_notifier *async)
 	struct v4l2_subdev *sd;
 
 	list_for_each_entry(sd, &v4l2_dev->subdevs, list) {
-		struct csiphy_device *csiphy = sd->host_priv;
+		struct camss_async_subdev *csd = sd->host_priv;
+		struct csiphy_device *csiphy;
 		struct media_entity *input, *sensor;
+		struct v4l2_subdev *other;
+		unsigned int nsensors = 0;
+		u32 flags;
 		unsigned int i;
 		int ret;
 
-		if (!csiphy)
+		if (!csd)
 			continue;
 
+		csiphy = &camss->csiphy[csd->interface.csiphy_id];
 		input = &csiphy->subdev.entity;
 		sensor = &sd->entity;
 
+		list_for_each_entry(other, &v4l2_dev->subdevs, list) {
+			struct camss_async_subdev *ocsd = other->host_priv;
+
+			if (ocsd && ocsd->interface.csiphy_id ==
+			    csd->interface.csiphy_id)
+				nsensors++;
+		}
+
+		/*
+		 * A CSIPHY shared by several sensors (combo mode) gets mutable
+		 * links, enabled for the sensor that currently provides the lane
+		 * configuration; userspace selects the active sensor by enabling
+		 * its link. A CSIPHY with a single sensor keeps the immutable link.
+		 */
+		if (nsensors > 1) {
+			csiphy->cfg.combo_mode = 1;
+			flags = csiphy->cfg.csi2 == &csd->interface.csi2 ?
+				MEDIA_LNK_FL_ENABLED : 0;
+		} else {
+			flags = MEDIA_LNK_FL_IMMUTABLE | MEDIA_LNK_FL_ENABLED;
+		}
+
 		for (i = 0; i < sensor->num_pads; i++) {
 			if (sensor->pads[i].flags & MEDIA_PAD_FL_SOURCE)
 				break;
@@ -5213,8 +5247,7 @@ static int camss_subdev_notifier_complete(struct v4l2_async_notifier *async)
 		}
 
 		ret = media_create_pad_link(sensor, i, input,
-					    MSM_CSIPHY_PAD_SINK,
-					    MEDIA_LNK_FL_IMMUTABLE | MEDIA_LNK_FL_ENABLED);
+					    MSM_CSIPHY_PAD_SINK, flags);
 		if (ret < 0) {
 			camss_link_err(camss, sensor->name, input->name, ret);
 			return ret;
