From df97b3eb9d30b2535ed6a04398ff4b40af05ad44 Mon Sep 17 00:00:00 2001
From: agrucza <a.grucza@gmx.net>
Date: Fri, 9 Oct 2026 15:04:21 +0200
Subject: [PATCH 08/12] HID: input: ignore the battery of the ELAN 04F3:430A
 touch controller

The ELAN I2C-HID touch/pen controller of the ASUS ProArt PZ13 exposes a
battery for the stylus that reports a constant 1 % whenever a pen is in
range (also after charging the pen for hours), so desktops show a stylus
at 1 % at all times. Ignore it, as done for the Surface Pro 12 ELAN
controller.

Signed-off-by: agrucza <a.grucza@gmx.net>
---
 drivers/hid/hid-ids.h   | 1 +
 drivers/hid/hid-input.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/drivers/hid/hid-ids.h b/drivers/hid/hid-ids.h
index 1059922ba..258577b96 100644
--- a/drivers/hid/hid-ids.h
+++ b/drivers/hid/hid-ids.h
@@ -464,6 +464,7 @@
 #define USB_DEVICE_ID_HP_X2_10_COVER	0x0755
 #define I2C_DEVICE_ID_CHROMEBOOK_TROGDOR_POMPOM	0x2F81
 #define I2C_DEVICE_ID_SURFACE_PRO_12IN  0x4376
+#define I2C_DEVICE_ID_ASUS_PROART_PZ13	0x430A
 
 #define USB_VENDOR_ID_ELECOM		0x056e
 #define USB_DEVICE_ID_ELECOM_BM084	0x0061
diff --git a/drivers/hid/hid-input.c b/drivers/hid/hid-input.c
index d05cf790b..58046c2f5 100644
--- a/drivers/hid/hid-input.c
+++ b/drivers/hid/hid-input.c
@@ -400,6 +400,8 @@ static const struct hid_device_id hid_battery_quirks[] = {
 	  HID_BATTERY_QUIRK_AVOID_QUERY },
 	{ HID_I2C_DEVICE(USB_VENDOR_ID_ELAN, I2C_DEVICE_ID_SURFACE_PRO_12IN),
 	  HID_BATTERY_QUIRK_IGNORE },
+	{ HID_I2C_DEVICE(USB_VENDOR_ID_ELAN, I2C_DEVICE_ID_ASUS_PROART_PZ13),
+	  HID_BATTERY_QUIRK_IGNORE },
 	/*
 	 * Elan HID touchscreens seem to all report a non present battery,
 	 * set HID_BATTERY_QUIRK_IGNORE for all Elan I2C and USB HID devices.
-- 
2.47.3

